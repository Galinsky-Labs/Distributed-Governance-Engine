# Names only. Never commit values. Add these only when implementing the owning PR.
DATABASE_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_KEY=
OIDC_STATE_KEY=
# Optional JSON: {"id":"policy-version","allowedFormats":["none"],"allowedAaguids":["explicit-reviewed-uuid"]}
# Absent means passkeys remain unavailable. Select the authenticator policy explicitly;
# do not use the browser test's virtual-authenticator AAGUID in a production policy.
PASSKEY_ATTESTATION_POLICY=
PUBLIC_ORIGIN=
# Callback is PUBLIC_ORIGIN/auth/callback, not caller configurable.
MIGRATION_DATABASE_URL=
TLS_KEY_FILE=
TLS_CERT_FILE=
QUILL_PRODUCT=civic
BIND_ADDRESS=127.0.0.1
PORT=8443
# Identity keys: independent 32-byte secrets encoded as 64 lowercase hexadecimal characters.
# DATABASE_URL: ordinary login granted dge_identity_runtime; migration owner stays separate.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
KEY_VALUE_URL=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
ANCHOR_RPC_URL=
ANCHOR_SIGNER_REFERENCE=
# Reference to a protected signing facility; never place a private key in source.
# Notifications (DCE-032). Token key: 64 lowercase hex characters, independent of the identity keys.
NOTIFICATION_TOKEN_KEY=
# Absent Postmark token means email delivery is unavailable; nothing is reported as sent.
POSTMARK_SERVER_TOKEN=
NOTIFICATION_EMAIL_FROM=
POSTMARK_MESSAGE_STREAM=
# Payments (DCE-030). Absent keys mean the provider is reported unavailable and purchase controls are hidden.
# PAYMENT_PROVIDER_SECRET / PAYMENT_WEBHOOK_SECRET above are unused generic placeholders.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional pinned Stripe API version, e.g. 2025-03-31.basil
STRIPE_API_VERSION=
# "enabled" offers administrator-confirmed invoicing through the manual provider.
BILLING_MANUAL_INVOICING=
# First-party passkey sign-in ("enabled") when no external OIDC provider is used; may run alongside OIDC.
SIGNIN_PASSKEYS=
# Base64 secret (>= 32 bytes) keying verified-person uniqueness digests.
DGE_PERSON_KEY_SECRET=
# Base64 PKCS#8 Ed25519 key signing transparency-log checkpoints; LOG_ID names the log.
LOG_SIGNING_KEY=
LOG_ID=
# Comma-separated anchor providers, e.g. "opentimestamps" (free Bitcoin calendars).
ANCHOR_PROVIDERS=
# "tls" (default, Node terminates TLS) or "edge-tls" (managed platform edge terminates TLS).
TRANSPORT_MODE=
