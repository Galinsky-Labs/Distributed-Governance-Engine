# Configuration names only. Keep the actual file and all credentials outside Git.
KC_HOSTNAME=
KC_DB_URL=
KC_DB_USERNAME=
KC_DB_PASSWORD=
KC_HTTPS_CERTIFICATE_FILE=/run/tls/server.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/run/tls/server.key
# Bootstrap credentials are temporary. Replace the temporary administrator with
# named MFA-protected operators and remove it before public acceptance.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
JAVA_OPTS_APPEND=-Djdk.tls.client.protocols=TLSv1.3
